{
  "expo": {
    "name": "財產盤點",
    "slug": "property-ckecking-app",
    "version": "0.0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "p-ckeck",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A4A4A",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#4A4A4A",
          "dark": {
            "backgroundColor": "#4A4A4A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允許讀取照片，用於保存財產照片。",
          "cameraPermission": "允許開啟相機，用於拍攝財產照片。",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允許讀取照片，用於保存財產照片。",
          "savePhotosPermission": "允許儲存照片至相簿。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
